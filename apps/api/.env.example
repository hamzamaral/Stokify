NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://stokify:stokify@localhost:5432/stokify?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_REFRESH_TTL_DAYS=7

CORS_ORIGIN=http://localhost:5173
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
LOG_LEVEL=debug

# DB boşsa uygulama açılışında demo verileri otomatik yükler
SEED_ON_EMPTY=true
